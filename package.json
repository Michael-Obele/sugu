{
	"name": "sugu",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"sugu"
	],
	"scripts": {
		"dev": "bun run build && wrangler dev",
		"build": "bun run --cwd sugu build",
		"deploy": "bun run build && wrangler deploy",
		"test": "bun test",
		"check": "bun run --cwd sugu check",
		"cf-typegen": "wrangler types",
		"format": "prettier --write .",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"typescript": "^5.5.2",
		"vite-plus": "1.1.0",
		"wrangler": "^4.149.0"
	},
	"dependencies": {
		"valibot": "^1.5.0"
	}
}
