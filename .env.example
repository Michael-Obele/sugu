# Sugu — local environment.
#
#     cp .env.example .env        # then fill in the values
#     ln -s .env .dev.vars        # once only, on a fresh clone (see below)
#
# `.env` is gitignored, and it is the ONLY file you edit: `.dev.vars` is a symlink to it.
# That way `wrangler dev` (which reads `.dev.vars`) and `bun run scripts/...` (which read
# `.env`) both see the same values, and there is only one place to keep them in step.
#
# Do NOT `cp` anything onto `.dev.vars` — that replaces the symlink with a real file and
# silently stops the two consumers agreeing.
#
# Use ONE value per key, local and production alike, then push the same values to
# production once — the Worker reads these names there too:
#
#     bunx wrangler secret put SUGU_PASSPHRASE     # repeat per key

# ---- where things point ------------------------------------------------------------
# Default target for the quota probe, so it runs with no flags.
SUGU_URL=https://sugu.svelte-apps.workers.dev

# ---- the app's own secrets ---------------------------------------------------------
# The passphrase you type on your phone to unlock the app. Make it a real passphrase,
# not a word: this Worker is on the public internet and that passphrase is the only
# thing between a stranger and your session Durable Objects.
SUGU_PASSPHRASE=

# HMAC key that signs your 7-day session tokens. 32 random bytes (`openssl rand -hex 32`).
# Rotating it invalidates every issued token, i.e. it logs the phone out — that is the
# intended escape hatch, not a bug.
TOKEN_SECRET=

# Guards /api/probe/*. Put the SAME value here and in production, or the quota probe
# gets a 401 against the deployed Worker.
ADMIN_TOKEN=

# ---- model providers ---------------------------------------------------------------
# Needed locally for the Worker to answer with a real model. In production these are
# `wrangler secret put` values and never live in a file.
#   DeepSeek:   https://platform.deepseek.com/api_keys
#   OpenRouter: https://openrouter.ai/keys
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---- test seam — leave commented out -----------------------------------------------
# `MODEL_STUB=1` makes the Worker answer with a deterministic fake instead of calling a
# provider. It exists so `bun test` never hits a live API (the test harness sets it
# itself). Never set this for real use.
# MODEL_STUB=1
