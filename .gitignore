# Planning material stays local: it travels with this machine, not with git.
# Seeded from AI-Plans/plans/sugu/ via plan-sync.sh --init; after seeding the
# plan/ copy here is the SOURCE OF TRUTH (see plan/README.md).
plan/

# SDD scratch workspace: task briefs, implementer reports, review packages and the
# progress ledger. Working state for the agent, never part of the product.
.superpowers/

# Cloudflare local state and secrets — never commit
.wrangler/
.dev.vars
.dev.vars.*
# ...but the template that documents the secret NAMES is tracked.
!.dev.vars.example
.env
.env.*
!.env.example

# Build and dependency output
dist/
node_modules/
*.tsbuildinfo
# SvelteKit's generated output, at whatever level a sync happened to run.
.svelte-kit/

# Editor and OS noise
.DS_Store
*.log
sugu/build
